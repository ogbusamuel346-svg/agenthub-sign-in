{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sameduhub-api",
  "main": "cloudflare/worker.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-10-22",
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "sameduhub-9f5dd",
    "PAYSTACK_MODE": "live",
    "TOPUPMATE_MODE": "live",
    "TOPUPMATE_API_BASE_URL": "https://connect.topupmate.com/api/",
    "TOPUPMATE_REQUEST_TIMEOUT_MS": "15000",
    "CLOUDFLARE_WALLET_CUTOVER": "true",
    "CLOUDFLARE_FUNDING_ENABLED": "true",
    "TOPUPMATE_PURCHASES_ENABLED": "true",
    "SUPPORT_EMAIL": "support@sameduhub.com",
    "SUPPORT_FROM_EMAIL": "SamEduHub Support <support@sameduhub.com>",
    "BREVO_SENDER_EMAIL": "support@sameduhub.com",
    "BREVO_SENDER_NAME": "SamEduHub"
  },
  "send_email": [
    {
      "name": "SUPPORT_MAILER",
      "destination_address": "support@sameduhub.com",
      "allowed_sender_addresses": ["support@sameduhub.com"],
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sameduhub",
      "database_id": "d6268652-e768-4f07-bf1b-440f795697e1",
      "migrations_dir": "migrations",
      "migrations_table": "schema_migrations"
    }
  ]
}
