# Firebase Web Configuration
# Retrieve these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"

# TopupMate API configuration (server-only; never use the VITE_ prefix here).
TOPUPMATE_API_BASE_URL="https://connect.topupmate.com/api/"
TOPUPMATE_API_TOKEN="REPLACE_WITH_YOUR_TOPUPMATE_API_TOKEN"
TOPUPMATE_REQUEST_TIMEOUT_MS="15000"

# Keep false until a server-verified Firebase identity, customer wallet and durable transaction store are configured.
TOPUPMATE_PURCHASES_ENABLED="false"
CUSTOMER_WALLET_PROVIDER=""
CUSTOMER_TRANSACTION_STORE=""
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""
FIREBASE_ADMIN_SERVICE_ACCOUNT_PATH=""
FIREBASE_ADMIN_USE_APPLICATION_DEFAULT="false"
FIREBASE_DATABASE_URL=""
FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"

# Cloudflare CLI reference only; keep credentials in Wrangler's ignored .dev.vars, never VITE_ variables.
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
# D1 database ID is assigned when the database is created; set it in wrangler.jsonc.
CLOUDFLARE_D1_DATABASE_ID=""
# Keep false until Firebase wallet balances and transaction history have been imported and reconciled.
CLOUDFLARE_WALLET_CUTOVER="false"

# Paystack wallet funding (server-only; use a test secret locally)
PAYSTACK_SECRET_KEY="sk_test_REPLACE_WITH_YOUR_PAYSTACK_SECRET_KEY"
PAYSTACK_MODE="test"
PAYSTACK_CALLBACK_URL="http://localhost:3000/api/paystack/callback"
PAYSTACK_FRONTEND_RETURN_URL=""

# Brevo SMTP transactional email configuration (server-only; never use VITE_ variables).
# BREVO_SMTP_PASSWORD is the Brevo SMTP key/password, not the Brevo API key.
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USERNAME="c011be001@smtp-brevo.com"
BREVO_SMTP_PASSWORD="REPLACE_WITH_YOUR_BREVO_SMTP_KEY"
# BREVO_FROM_EMAIL must be a verified sender in Brevo.
BREVO_FROM_EMAIL="ogbu8372@gmail.com"
BREVO_FROM_NAME="SamEduHub"
BREVO_ADMIN_EMAIL="ogbu8372@gmail.com"

# Optional: protects the internal supplier-balance route; never expose it to the browser.
TOPUPMATE_ADMIN_VIEW_TOKEN=""
