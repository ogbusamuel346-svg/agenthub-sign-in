{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sameduhub-api-preview",
  "main": "cloudflare/worker.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-10-22",
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "sameduhub-9f5dd",
    "PAYSTACK_MODE": "test",
    "TOPUPMATE_MODE": "live",
    "CLOUDFLARE_WALLET_CUTOVER": "true",
    "CLOUDFLARE_FUNDING_ENABLED": "true",
    "PAYSTACK_VIRTUAL_ACCOUNTS_ENABLED": "false",
    "PAYSTACK_VIRTUAL_ACCOUNT_BANK": "test-bank",
    "SUPPORT_EMAIL": "support@sameduhub.com",
    "SUPPORT_FROM_EMAIL": "SamEduHub Support <support@sameduhub.com>",
    "BREVO_SENDER_EMAIL": "support@sameduhub.com",
    "BREVO_SENDER_NAME": "SamEduHub",
    // Paystack can be tested with test credentials; TopupMate currently
    // targets its live API, so keep supplier purchases disabled until funded.
    "TOPUPMATE_PURCHASES_ENABLED": "false"
  },
  "send_email": [
    {
      "name": "SUPPORT_MAILER",
      "destination_address": "support@sameduhub.com",
      "allowed_sender_addresses": ["support@sameduhub.com"],
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sameduhub-preview",
      "database_id": "33a422a4-6583-4aa4-aeff-78525ddbcf63",
      "migrations_dir": "migrations",
      "migrations_table": "schema_migrations"
    }
  ]
}
