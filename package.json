{
  "name": "sameduhub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "start": "tsx server/index.ts",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:preview:build": "vite build --configLoader native --mode preview",
    "cf:preview:migrate": "wrangler d1 migrations apply sameduhub-preview --remote --config wrangler.preview.jsonc",
    "cf:preview:reconcile-firebase": "tsx scripts/reconcile-firebase-preview.ts",
    "cf:preview:deploy": "npm run cf:preview:build && wrangler deploy --config wrangler.preview.jsonc --secrets-file .dev.vars",
    "cf:d1:local": "wrangler d1 migrations apply sameduhub --local",
    "cf:d1:remote": "wrangler d1 migrations apply sameduhub --remote",
    "cf:migrate:plan": "tsx scripts/plan-firebase-import.ts",
    "cf:config:d1": "tsx scripts/set-cloudflare-d1-id.ts",
    "test": "node --import tsx --test --test-concurrency=1",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
